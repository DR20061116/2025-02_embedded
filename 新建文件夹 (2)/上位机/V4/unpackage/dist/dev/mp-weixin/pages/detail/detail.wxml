<view class="page"><view class="wrap"><view class="weather-section"><view class="weather-left"><text class="weather-icon">{{weatherIcon}}</text><view><text class="weather-temp">{{weatherTemp+"°C"}}</text><text class="weather-desc">{{weatherDesc}}</text></view></view><view class="weather-right"><text class="weather-time">{{clockTime}}</text><text class="weather-date">{{clockDate}}</text><text class="weather-location">{{weatherLoc}}</text></view></view><view class="profile-section"><view class="profile-avatar">🔋</view><view class="profile-info"><text class="profile-name">本质安全型防爆电源</text><text class="profile-desc">智能监控系统 · 实时监测中</text></view><view class="{{['status-badge',deviceOnline?'online':'offline']}}">{{''+(deviceOnline?'已连接':'未连接')+''}}</view></view><view class="section-title">📊 实时数据</view><view class="data-container"><view class="data-item"><view class="data-left"><text class="data-emoji">🔥</text></view><view class="data-right"><text class="data-label">甲烷浓度</text><text class="data-value" style="{{'color:'+(deviceColorMap.ch4_concent)+';'}}">{{$root.m0+''}}<text class="data-unit">%</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">💨</text></view><view class="data-right"><text class="data-label">一氧化碳</text><text class="data-value" style="{{'color:'+(deviceColorMap.co)+';'}}">{{$root.m1+''}}<text class="data-unit">ppm</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">🌿</text></view><view class="data-right"><text class="data-label">二氧化碳</text><text class="data-value" style="{{'color:'+(deviceColorMap.co2)+';'}}">{{$root.m2+''}}<text class="data-unit">ppm</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">😷</text></view><view class="data-right"><text class="data-label">PM2.5</text><text class="data-value" style="{{'color:'+(deviceColorMap.pm2_5)+';'}}">{{$root.m3+''}}<text class="data-unit">μg/m³</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">💧</text></view><view class="data-right"><text class="data-label">环境湿度</text><text class="data-value" style="{{'color:'+(deviceColorMap.env_humidity)+';'}}">{{$root.m4+''}}<text class="data-unit">%RH</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">🌡</text></view><view class="data-right"><text class="data-label">环境温度</text><text class="data-value" style="{{'color:'+(deviceColorMap.env_temp)+';'}}">{{$root.m5+''}}<text class="data-unit">°C</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">🔌</text></view><view class="data-right"><text class="data-label">器件温度</text><text class="data-value" style="{{'color:'+(deviceColorMap.device_temp)+';'}}">{{$root.m6+''}}<text class="data-unit">°C</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">⚡</text></view><view class="data-right"><text class="data-label">输出电流</text><text class="data-value" style="{{'color:'+(deviceColorMap.output_current)+';'}}">{{$root.m7+''}}<text class="data-unit">A</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">🔋</text></view><view class="data-right"><text class="data-label">输出电压</text><text class="data-value" style="{{'color:'+(deviceColorMap.output_voltage)+';'}}">{{$root.m8+''}}<text class="data-unit">V</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">⏱</text></view><view class="data-right"><text class="data-label">运行时长</text><text class="data-value" style="{{'color:'+(deviceColorMap.runtime_hours)+';'}}">{{$root.m9+''}}<text class="data-unit">h</text></text></view></view><view class="data-item"><view class="data-left"><text class="data-emoji">💚</text></view><view class="data-right"><text class="data-label">健康评分</text><text class="data-value" style="{{'color:'+(deviceColorMap.health_score)+';'}}">{{$root.m10+''}}<text class="data-unit">分</text></text></view></view><view class="data-item data-item-invisible"></view></view><view class="control-section"><view class="section-title">🔧 远程控制</view><view class="control-card"><view class="control-info"><text class="control-icon">💡</text><text class="control-label">LED灯</text></view><view class="control-btns"><button class="{{['ctrl-btn','ctrl-on',deviceValueMap.LED?'active':'']}}" disabled="{{settingInProgress==='LED'}}" data-event-opts="{{[['tap',[['setProperty',['LED',true]]]]]}}" bindtap="__e">开启</button><button class="{{['ctrl-btn','ctrl-off',!deviceValueMap.LED?'active':'']}}" disabled="{{settingInProgress==='LED'}}" data-event-opts="{{[['tap',[['setProperty',['LED',false]]]]]}}" bindtap="__e">关闭</button></view></view><view class="control-card"><view class="control-info"><text class="control-icon">🔔</text><text class="control-label">蜂鸣器报警</text></view><view class="control-btns"><button class="{{['ctrl-btn','ctrl-on',deviceValueMap.BUZZER?'active':'']}}" disabled="{{settingInProgress==='BUZZER'}}" data-event-opts="{{[['tap',[['setProperty',['BUZZER',true]]]]]}}" bindtap="__e">开启</button><button class="{{['ctrl-btn','ctrl-off',!deviceValueMap.BUZZER?'active':'']}}" disabled="{{settingInProgress==='BUZZER'}}" data-event-opts="{{[['tap',[['setProperty',['BUZZER',false]]]]]}}" bindtap="__e">关闭</button></view></view></view><view class="footer"><text class="footer-time">{{"最后更新: "+lastUpdate}}</text></view></view></view>