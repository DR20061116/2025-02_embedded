





































































































































































































































































































































































































































































































































































/* ========== 全局 ========== */
.page {
    background: #f5f6fa;
    min-height: 100vh;
}
.wrap {
    padding: 20rpx 30rpx 40rpx;
    overflow-y: auto;
    box-sizing: border-box;
}
/* ========== 天气时间 ========== */
.weather-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #74b9ff, #0984e3);
    border-radius: 28rpx;
    padding: 24rpx 30rpx;
    margin-bottom: 24rpx;
    color: #fff;
}
.weather-left { display: flex; align-items: center; gap: 16rpx;
}
.weather-icon { font-size: 64rpx;
}
.weather-temp { font-size: 44rpx; font-weight: bold; display: block;
}
.weather-desc { font-size: 24rpx; opacity: 0.9;
}
.weather-right { text-align: right;
}
.weather-time { font-size: 48rpx; font-weight: bold; display: block; letter-spacing: 2rpx;
}
.weather-date { font-size: 22rpx; opacity: 0.85; display: block; margin-top: 4rpx;
}
.weather-location { font-size: 22rpx; opacity: 0.75; display: block; margin-top: 4rpx;
}
/* ========== 设备信息栏 ========== */
.profile-section {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 28rpx;
    padding: 28rpx 30rpx;
    margin-bottom: 24rpx;
    color: #fff;
}
.profile-avatar { font-size: 64rpx; margin-right: 24rpx;
}
.profile-info { flex: 1;
}
.profile-name { font-size: 32rpx; font-weight: bold; display: block;
}
.profile-desc { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; display: block;
}
.status-badge { font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 30rpx; font-weight: bold;
}
.status-badge.online { background: rgba(39, 174, 96, 0.3); color: #fff;
}
.status-badge.offline { background: rgba(149, 165, 166, 0.3); color: #ddd;
}
/* ========== 标题 ========== */
.section-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #2c3e50;
    margin-bottom: 20rpx;
}
/* ========== 数据网格 ========== */
.data-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
    margin-bottom: 32rpx;
}
.data-item {
    background: #fff;
    border-radius: 24rpx;
    padding: 24rpx 20rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.data-item-invisible {
    visibility: hidden;
}
.data-left {
    width: 80rpx;
    height: 80rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16rpx;
    background: #f0f4ff;
    flex-shrink: 0;
}
.data-emoji {
    font-size: 40rpx;
}
.data-right {
    flex: 1;
    min-width: 0;
}
.data-label {
    font-size: 24rpx;
    color: #636e72;
    display: block;
    margin-bottom: 4rpx;
}
.data-value {
    font-size: 40rpx;
    font-weight: bold;
    color: #2d3436;
    line-height: 1.2;
}
.data-unit {
    font-size: 22rpx;
    font-weight: normal;
    color: #999;
}
/* ========== 远程控制 ========== */
.control-section {
    margin-bottom: 24rpx;
}
.control-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    border-radius: 24rpx;
    padding: 24rpx 30rpx;
    margin-bottom: 16rpx;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.control-info {
    display: flex;
    align-items: center;
    gap: 16rpx;
    flex: 1;
}
.control-icon { font-size: 40rpx;
}
.control-label { font-size: 28rpx; font-weight: bold; color: #2d3436;
}
.control-btns {
    display: flex;
    gap: 12rpx;
}
.ctrl-btn {
    font-size: 24rpx;
    padding: 12rpx 28rpx;
    border-radius: 30rpx;
    border: 2rpx solid #b2bec3;
    background: #fff;
    color: #636e72;
    font-weight: bold;
    line-height: initial;
    text-align: center;
}
.ctrl-btn.active {
    border-color: transparent;
    color: #fff;
}
.ctrl-on.active { background: #27ae60;
}
.ctrl-off.active { background: #e74c3c;
}
.ctrl-btn[disabled] {
    opacity: 0.5;
}
/* ========== 底部 ========== */
.footer {
    text-align: center;
    padding: 20rpx 0 40rpx;
}
.footer-time {
    font-size: 22rpx;
    color: #b2bec3;
}

